# 네이버 검색광고 API (https://manage.searchad.naver.com → 도구 → API 사용 관리)
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET=

# 네이버 검색 API — NAVER API HUB (2026.6 이관). 네이버클라우드 콘솔 → Application Services → NAVER API HUB
#   → Application 생성 → API 관리 → [인증 정보]
NAVER_NCP_KEY_ID=
NAVER_NCP_KEY=
# (구) 개발자센터 키. 2027-06-30 까지만 동작. HUB 키가 없을 때만 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 https://www.data.go.kr — 기상청 단기예보, 전국등산로표준데이터, 산림청 산정보, 한국관광공사 관광사진(포토코리아) — 활용신청 각각 필요, 키는 하나
DATA_GO_KR_KEY=

# 블로그
NAVER_BLOG_ID=

# Claude: API 키 불필요. 설치된 Claude Code CLI(claude -p)를 구독 계정으로 사용

# 배포 (선택)
X_BEARER_TOKEN=
THREADS_ACCESS_TOKEN=
